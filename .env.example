# Copy to ./.env (gitignored) and fill in. Used by docs/port/go-online/TWO_CLIENT_TEST.md
# to mint refresh tokens for the self-hosted backend.
#
# Must equal the backend's JwtSettings__Key (~/go-services/.env). Generate with:
#   openssl rand -hex 48
# If this value was ever committed/exposed, ROTATE it on both sides and restart the backend.
GENERALSX_ONLINE_JWT_KEY=CHANGE_ME_openssl_rand_hex_48
