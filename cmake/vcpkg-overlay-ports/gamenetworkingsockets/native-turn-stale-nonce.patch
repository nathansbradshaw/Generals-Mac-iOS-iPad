+// GeneralsX @bugfix Codex 09/10/2026 Renew only NONCE on a matched438 challenge, retaining realm and key.
+static bool GeneralsXHandleTURNStaleNonce( const RecvSTUNPktInfo_t &info, ICESessionInterface &intf )
+{
+    if ( !info.m_pHeader || intf.m_strTURNRealm.empty()
+        || info.m_usecNow < intf.m_usecTURNRetryAfter
+        || info.m_pHeader->m_nMessageType != ( info.m_pRequest->m_nMessageType | 0x0110 ) )
+        return false;
+    const STUNAttribute *err = FindAttributeOfType( info.m_pAttributes, info.m_nAttributes, k_nSTUN_Attr_ErrorCode );
+    const STUNAttribute *realm = FindAttributeOfType( info.m_pAttributes, info.m_nAttributes, k_nSTUN_Attr_Realm );
+    const STUNAttribute *nonce = FindAttributeOfType( info.m_pAttributes, info.m_nAttributes, k_nSTUN_Attr_Nonce );
+    if ( !err || err->m_nLength < 4 || !realm || !nonce || nonce->m_nLength == 0 || nonce->m_nLength > 763 )
+        return false;
+    const uint8 *errorBytes = reinterpret_cast<const uint8*>( err->m_pData );
+    if ( errorBytes[2] != 4 || errorBytes[3] != 38
+        || realm->m_nLength != intf.m_strTURNRealm.size()
+        || V_memcmp( realm->m_pData, intf.m_strTURNRealm.data(), realm->m_nLength ) != 0 )
+        return false;
+    std::string nextNonce( reinterpret_cast<const char*>( nonce->m_pData ), nonce->m_nLength );
+    if ( nextNonce.find( '\0' ) != std::string::npos || nextNonce == intf.m_strTURNNonce )
+        return false;
+    intf.m_strTURNNonce.swap( nextNonce );
+    intf.m_usecTURNRetryAfter = info.m_usecNow + k_nMillion;
+    SpewMsg( "ICE: TURN stale nonce438 accepted for method0x%x; retrying authenticated request\n",
+        info.m_pRequest->m_nMessageType );
+    return true;
+}
